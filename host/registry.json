{
  "component": "host:actions",
  "actions": [
    {
      "name": "backup.rerun_observability",
      "for_kinds": ["failed_backup"],
      "params": {"host": {"kind": "target_host"}},
      "risk": "low",
      "reversible": "regenerable",
      "pre": ["backup_age_above(26h)", "not_running"],
      "pre_shadow": ["backup_age_above(20h)", "not_running"],
      "check": {"verify": "backup_newer_than_execution", "within": "60m"},
      "limits": {"per_target_per_day": 2},
      "timeout": "30m"
    }
  ]
}
