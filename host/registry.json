{
  "component": "host:actions",
  "actions": [
    {
      "name": "backup.rerun",
      "for_kinds": ["failed_backup"],
      "params": {"host": {"kind": "target_host"}},
      "risk": "low",
      "reversible": "regenerable",
      "pre": ["backup_age_above(26h)", "not_running"],
      "pre_shadow": ["backup_age_above(25h)", "not_running"],
      "check": {"verify": "backup_newer_than_execution", "within": "60m"},
      "limits": {"per_target_per_day": 2},
      "timeout": "30m"
    },
    {
      "name": "repo.process_change",
      "executor": "repo",
      "for_kinds": ["process_change"],
      "params": {
        "file": {"kind": "enum", "enum": ["host/registry.json", "none"]},
        "rule": {"kind": "enum", "enum": ["below_cycle", "self_clearing", "fix_not_holding"]},
        "change": {"kind": "text", "max": 4000}
      },
      "risk": "low",
      "reversible": "yes",
      "pre": [],
      "check": {"verify": "", "within": "0s"},
      "limits": {"per_target_per_day": 1},
      "timeout": "168h"
    },
    {
      "name": "github.open_pr",
      "executor": "repo",
      "for_kinds": ["code_bug", "code_bug_python", "process_change", "dependency_update"],
      "params": {
        "repo": {"kind": "enum", "enum": ["example/shop", "example/api", "example/fleets"]},
        "base": {"kind": "text", "max": 40},
        "title": {"kind": "text", "max": 200},
        "body": {"kind": "text", "max": 8000},
        "diff": {"kind": "text", "max": 16000}
      },
      "risk": "low",
      "reversible": "yes",
      "pre": [],
      "check": {"verify": "pr_resolved", "within": "336h"},
      "limits": {"per_target_per_day": 1},
      "timeout": "30m"
    },
    {
      "name": "crm.update_field",
      "executor": "routine",
      "for_kinds": ["crm_fix"],
      "params": {
        "contact": {"kind": "text", "max": 64},
        "field": {"kind": "enum", "enum": ["email", "country"]},
        "from": {"kind": "text", "max": 200},
        "to": {"kind": "text", "max": 200}
      },
      "risk": "low",
      "reversible": "yes",
      "pre": [],
      "check": {"verify": "crm_field_set", "within": "10m"},
      "limits": {"per_target_per_day": 5},
      "timeout": "5m"
    },
    {
      "name": "crm.merge",
      "executor": "routine",
      "for_kinds": ["crm_fix"],
      "params": {
        "keep": {"kind": "text", "max": 64},
        "drop": {"kind": "text", "max": 64}
      },
      "risk": "medium",
      "reversible": "no",
      "pre": [],
      "check": {"verify": "crm_merged", "within": "10m"},
      "limits": {"per_target_per_day": 1},
      "timeout": "5m"
    },
    {
      "name": "campaign.launch",
      "executor": "routine",
      "for_kinds": ["campaign_ready"],
      "params": {
        "campaign": {"kind": "text", "max": 64}
      },
      "risk": "medium",
      "reversible": "no",
      "pre": [],
      "check": {"verify": "campaign_status", "within": "10m"},
      "limits": {"per_target_per_day": 1},
      "timeout": "5m"
    },
    {
      "name": "campaign.hold",
      "executor": "routine",
      "for_kinds": ["campaign_ready"],
      "params": {
        "campaign": {"kind": "text", "max": 64},
        "reason": {"kind": "text", "max": 2000}
      },
      "risk": "low",
      "reversible": "yes",
      "pre": [],
      "check": {"verify": "campaign_status", "within": "10m"},
      "limits": {"per_target_per_day": 2},
      "timeout": "5m"
    },
    {
      "name": "email.send",
      "executor": "routine",
      "for_kinds": ["prospect_new"],
      "params": {
        "prospect": {"kind": "text", "max": 64},
        "to": {"kind": "text", "max": 200},
        "subject": {"kind": "text", "max": 200},
        "body": {"kind": "text", "max": 4000},
        "facts": {"kind": "text", "max": 200}
      },
      "risk": "medium",
      "reversible": "no",
      "pre": [],
      "check": {"verify": "email_in_outbox", "within": "10m"},
      "limits": {"per_target_per_day": 1},
      "timeout": "5m"
    },
    {
      "name": "crm.flag_account",
      "executor": "routine",
      "for_kinds": ["renewal_risk"],
      "params": {
        "account": {"kind": "text", "max": 64},
        "risk": {"kind": "enum", "enum": ["medium", "high"]},
        "note": {"kind": "text", "max": 1000}
      },
      "risk": "low",
      "reversible": "yes",
      "pre": [],
      "check": {"verify": "account_flagged", "within": "10m"},
      "limits": {"per_target_per_day": 1},
      "timeout": "5m"
    },
    {
      "name": "plumbing.create_tasks",
      "executor": "routine",
      "for_kinds": ["meeting"],
      "params": {
        "items": {"kind": "text", "max": 4000}
      },
      "risk": "medium",
      "reversible": "regenerable",
      "pre": [],
      "check": {"verify": "plumbing_confirmed", "within": "10m"},
      "limits": {"per_target_per_day": 3},
      "timeout": "2m"
    },
    {
      "name": "plumbing.post_decisions",
      "executor": "routine",
      "for_kinds": ["meeting"],
      "params": {
        "page": {"kind": "enum", "enum": ["decisions"]},
        "text": {"kind": "text", "max": 8000}
      },
      "risk": "medium",
      "reversible": "regenerable",
      "pre": [],
      "check": {"verify": "plumbing_confirmed", "within": "10m"},
      "limits": {"per_target_per_day": 3},
      "timeout": "2m"
    },
    {
      "name": "plumbing.reply",
      "executor": "routine",
      "for_kinds": ["question"],
      "params": {
        "channel": {"kind": "enum", "enum": ["general"]},
        "thread": {"kind": "text", "max": 64},
        "text": {"kind": "text", "max": 3000}
      },
      "risk": "medium",
      "reversible": "yes",
      "pre": [],
      "check": {"verify": "plumbing_confirmed", "within": "10m"},
      "limits": {"per_target_per_day": 3},
      "timeout": "2m"
    },
    {
      "name": "plumbing.post",
      "executor": "routine",
      "for_kinds": ["team_brief"],
      "params": {
        "channel": {"kind": "enum", "enum": ["general"]},
        "text": {"kind": "text", "max": 3000}
      },
      "risk": "medium",
      "reversible": "yes",
      "pre": [],
      "check": {"verify": "plumbing_confirmed", "within": "10m"},
      "limits": {"per_target_per_day": 1},
      "timeout": "2m"
    },
    {
      "name": "plumbing.retract",
      "executor": "routine",
      "for_kinds": ["correction"],
      "params": {
        "message_ref": {"kind": "text", "max": 200},
        "reason": {"kind": "text", "max": 500}
      },
      "risk": "medium",
      "reversible": "regenerable",
      "pre": [],
      "check": {"verify": "plumbing_confirmed", "within": "10m"},
      "limits": {"per_target_per_day": 5},
      "timeout": "2m"
    }
  ]
}
