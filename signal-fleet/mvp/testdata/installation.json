{
  "cleanup_markers": ["crashshoptest"],
  "repo_map": {
    "SHOP": "example/shop",
    "LITELLM": "example/ops",
    "API": "example/api",
    "PLAYER": "example/api",
    "GI-KG-VIEWER": "example/api",
    "EVALS": "example/evals",
    "SITE-A": "example/site",
    "SITE-B": "example/site"
  },
  "instance_repo_map": {
    "prod-edge": "example/api"
  },
  "ops_repo": "example/ops",
  "glitchtip_org": "example",
  "chain_repos": ["example/shop"],
  "assistant_backend": "192.0.2.10:11435",
  "edge_instance": "prod-edge",
  "probe_log_selector": {
    "api-pipeline": "service:api-pipeline", "api-api": "service:api-api",
    "player-api": "service:player-api", "player-mcp": "service:player-mcp",
    "player-obs": "service:player-obs",
    "shop-prod": "service:shop-web", "shop-lab-api": "service:shop-lab-api", "shop-mcp": "service:shop-mcp",
    "evals-inspector": "service:evals-inspector", "evals-web": "service:evals-web",
    "litellm-prod": "service:litellm-gateway",
    "site-a-web": "app:websites", "site-b-web": "app:websites"
  },
  "probe_metric_job": {
    "player-mcp": "player_mcp", "player-obs": "player_obs",
    "shop-prod": "shop", "shop-lab-api": "shop", "shop-mcp": "shop",
    "evals-inspector": "evals-inspector", "evals-mcp": "evals-mcp",
    "moss-model-host-transcription": "moss-app", "pyannote-model-host-diarization": "pyannote-app", "delivery": "delivery"
  },
  "staleness_alert_match": [["launch data stale"], ["shop", "stale"]],
  "staleness_evidence": [
    {"name": "refresh_logs", "kind": "logs", "query": "app:shop AND _time:{window} | sort by (_time) desc | limit 25"},
    {"name": "refresh_job_logs", "kind": "logs", "query": "job:shop-data-refresh AND _time:{window} | sort by (_time) desc | limit 25"},
    {"name": "shop_up", "kind": "metric", "query": "up{job=~\".*shop.*\"}"}
  ],
  "staleness_fixture": {
    "id": "grafana-shop-stale",
    "fingerprint": "grafana:shop-stale",
    "alertname": "Shop launch data stale (no refresh in 7h)",
    "labels": {"alertname": "Shop launch data stale"},
    "summary": "shop data refresh alarm; verify against evidence"
  },
  "source_state": {
    "description": "shop data-refresh state (last successful refresh)",
    "query": "job:shop-data-refresh AND _time:24h | sort by (_time) desc | limit 10"
  },
  "operational_reasons": {
    "upstream-rate-limit": "operational state (upstream-rate-limit) — the provider's shared pool refused upstream of us; nothing in our code or config to fix (example/ops #17). Acknowledged, not ticketed."
  },
  "group_rules": [
    {"pattern": "shop-worker|resilience fuse", "ignore_case": true, "key": "shop-worker-fuse"}
  ],
  "scrub": [
    {"pattern": "\\b(?:www\\.)?shop\\.example\\b", "replace": "example-shop.test"},
    {"pattern": "\\bhost-01\\.local\\b", "replace": "<host>.local"},
    {"pattern": "\\bprod-edge\\b", "replace": "prod-host"}
  ]
}
